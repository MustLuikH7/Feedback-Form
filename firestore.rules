    function isKnownSubject(value) {
      return value in [
        "Digioskuste arendamine",
        "Õpitee",
        "IT valdkonna alusteadmised",
        "Eesti keel",
        "Minapilt",
        "Programmeerimise alused",
        "Matemaatika",
