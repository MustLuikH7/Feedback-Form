        "Sündmusfoto",
        "Portee- ja grupifoto",
        "Analoogfotograafia",
        "Fototehnika",
        "Tootefoto",
        "Kompositsioon",
        "Fototootlus",
        "Mina ja minu tulevik",
        "Suhtlemine ja koostööoskuse arendamine",
        "Ainealse eesti keele oskuse arendamine",
        "Õpioskuste arendamine",
        "Rakendustarkvara",
        "Op. süsteemide alused",
        "Elektrivaldkonna ohutus ja esmaabi",
        "Elektrimootorid ja -ajamid",
        "Aruannete vorm",
        "Elektrimõõtmised",
        "Eesti energiasüsteem",
        "Sisetööde elektriku kutse iseloomustus",
        "Erialase joonestamise alused",
        "SQL",
        "Arvutivõrkude haldus, seadmed ja võrguteenused",
        "Klienditeenindus",
        "Lepingud ja hanked",
        "Kutse-eetika",
        "Rakendusserverite alused",
        "Sissejuhatus õpingutesse",
        "Ohutegurid töökohal",
        "Erinevad hajusrakendused",
        "Agiilne tarkvaraarendus",
        "Tarkvara testimene",
        "Programmeerimine",
        "Projektijuhtimine",
      ];
    }
    // END GENERATED LISTS

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidFeedback(data) {
      return data.keys().hasAll(['subject', 'teacher', 'grade', 'comment',
                                 'firstName', 'lastName', 'uid', 'createdAt']) &&
             data.keys().hasOnly(['subject', 'teacher', 'grade', 'comment',
                                  'firstName', 'lastName', 'uid', 'createdAt']) &&
             isKnownSubject(data.subject) &&
             isKnownTeacher(data.teacher) &&
             data.grade is int && data.grade >= 1 && data.grade <= 5 &&
             isString(data.comment, 0, 2000) &&
             isString(data.firstName, 0, 100) &&
             isString(data.lastName, 0, 100) &&
             data.uid == request.auth.uid &&
             data.createdAt == request.time;
    }

    function isValidStaff(data) {
      return data.keys().hasAll(['email', 'teacher', 'role']) &&
             data.keys().hasOnly(['email', 'teacher', 'role']) &&
             isString(data.email, 3, 200) &&
             (data.teacher == null || isKnownTeacher(data.teacher)) &&
             data.role in ['teacher', 'admin'];
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /feedback/{feedbackId} {
      allow create: if isAuthenticated() && isValidFeedback(request.resource.data);
      allow read: if isAdmin() ||
                     (isStaff() && resource.data.teacher == staffData().teacher);
      allow delete: if isAdmin();
      allow update: if false;
    }

    match /staff/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isAdmin() && isValidStaff(request.resource.data);
      allow delete: if isAdmin();
    }

    // Kõik muu on vaikimisi keelatud.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
