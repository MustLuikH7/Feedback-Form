rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: feedback
// Document ID: auto-generated (addDoc)
// Fields:
//   - subject:   string (required, one of subjects.json)  - õppeaine nimi
//   - teacher:   string (required, one of teachers.json)  - õpetaja täisnimi
//   - grade:     int    (required, 1-5)                   - hinne
//   - comment:   string (required, 0-2000 chars) - kommentaar, võib olla tühi
//   - firstName: string (required, 0-100 chars)  - tühi = anonüümne
//   - lastName:  string (required, 0-100 chars)  - tühi = anonüümne
//   - uid:       string (required, == request.auth.uid) - vastaja (anonüümne) id
//   - createdAt: timestamp (required, == request.time)
//
// Tagasisidet saavad lisada kõik sisselogitud (ka anonüümsed) kasutajad.
// Lugeda saab õpetaja ainult enda kohta käivat tagasisidet, admin kõike.
// Muuta ei saa keegi, kustutada saab ainult admin (nt spämmi eemaldamiseks).
//
// Collection: staff
// Document ID: Firebase Auth uid
// Fields:
//   - email:   string (required, 3-200 chars)
//   - teacher: string | null (required, one of teachers.json) - kelle tagasisidet näeb
//   - role:    string (required, 'teacher' | 'admin')
//
// Kirjutada saab ainult admin. Kasutaja näeb oma dokumenti, admin kõiki.
// Esimene admin luuakse käsitsi (Firebase konsool / admin token).
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function staffPath() {
      return /databases/$(database)/documents/staff/$(request.auth.uid);
    }

    function isStaff() {
      return isAuthenticated() && exists(staffPath());
    }

    function staffData() {
      return get(staffPath()).data;
    }

    function isAdmin() {
      return isStaff() && staffData().role == 'admin';
    }

    function isString(value, minLen, maxLen) {
      return value is string && value.size() >= minLen && value.size() <= maxLen;
    }

    // Loendid genereeritakse teachers.json ja subjects.json põhjal:
    //   node scripts/sync-rules-lists.mjs
    // (käivitub automaatselt ka `firebase deploy --only firestore` eel).
    // BEGIN GENERATED LISTS
